#!/bin/bash -l

#SBATCH --mail-user=XXXX@XXX.com
#SBATCH --mail-type=FAIL,END

#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=20
#SBATCH --mem=100G
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --time=3-00:00:00

module load gcc cuda cudnn python
source XXXXX/mace_2/mace-env-2/bin/activate
NAME="biodi"

mace_run_train \
    --name="$NAME" \
    --train_file="bio_dimers_train.xyz" \
    --valid_file="bio_dimers_valid.xyz" \
    --test_file="bio_dimers_test.xyz" \
    --log_dir="${NAME}_log" \
    --checkpoints_dir="${NAME}_checkpoints" \
    --results_dir="${NAME}_results" \
    --E0s="{1: -16.3878, 6: -1037.1395, 7: -1489.3353, 8: -2048.7069}" \
    --loss="weighted" \
    --energy_weight=1 \
    --forces_weight=10 \
    --swa \
    --start_swa=400 \
    --device=cuda \
    --batch_size=32 \
    --max_num_epochs=1000 \
    --seed=20210792 \
    --model="MACE" \
    --hidden_irreps='128x0e + 128x1o' \
    --max_L=2 \
    --r_max=5.0 \
    --amsgrad \
    --lr=1e-4 \
    --eval_interval=1 \
    --keep_checkpoints \
    --save_all_checkpoints \
    --enable_cueq=True \
    --wandb \
    --wandb_project="mace_finalrun" \
    --wandb_name="$NAME" \
